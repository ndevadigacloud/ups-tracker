# Copy to config.env and fill in. config.env is gitignored - never commit real
# credentials or connection strings.

AWS_REGION=us-east-1
STACK_PREFIX=ups-tracker

# MongoDB Atlas connection string with NO database name at the end.
# Create a free cluster at https://cloud.mongodb.com, add a DB user, and allow
# network access from 0.0.0.0/0 (or tighten to the VPC's egress IPs later).
# shipment-service and facility-service each append their own db name
# (shipments / facilities) to this at deploy time.
MONGO_ATLAS_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
